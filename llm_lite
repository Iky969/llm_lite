"""
Mini Language Model (Char-RNN / LSTM) dari Nol
Menggunakan PyTorch untuk Pelatihan dan Pembangkitan Teks Karakter Mandiri
"""

import math
import random
import time
import torch
import torch.nn as nn
import torch.optim as optim

# ==========================================
# 1. PERSIAPAN DATASET DAN TOKENISASI
# ==========================================

# Dataset teks sampel: cuplikan ensiklopedia / pengenalan AI & komputasi
raw_text = """
Kecerdasan buatan atau AI adalah simulasi kecerdasan manusia yang dimodelkan dalam mesin.
Mesin ini diprogram untuk berpikir seperti manusia dan meniru tindakan mereka.
Karakteristik ideal dari kecerdasan buatan adalah kemampuannya untuk merasionalisasi dan mengambil tindakan
yang memiliki peluang terbaik untuk mencapai tujuan tertentu.
Subkumpulan dari kecerdasan buatan adalah pembelajaran mesin atau machine learning.
Pembelajaran mesin berfokus pada pengembangan program komputer yang dapat mengakses data dan menggunakannya
untuk belajar mandiri tanpa bantuan aturan manusia secara terus menerus.
Proses pembelajaran dimulai dengan pengamatan atau data, seperti contoh, pengalaman langsung, atau instruksi,
untuk mencari pola dalam data dan membuat keputusan yang lebih baik di masa depan.
Jaringan saraf tiruan terinspirasi oleh jaringan saraf biologis otak manusia.
Dengan memperhatikan relasi antar karakter dan kata, model bahasa dapat memprediksi kata berikutnya secara tepat.
"""

# Pemetaan karakter unik (Character-level vocabulary)
chars = sorted(list(set(raw_text)))
vocab_size = len(chars)
char_to_idx = {ch: i for i, ch in enumerate(chars)}
idx_to_char = {i: ch for i, ch in enumerate(chars)}

print(f"Total Karakter dalam Teks: {len(raw_text)}")
print(f"Jumlah Karakter Unik (Vocab Size): {vocab_size}")

# Konversi seluruh teks menjadi indeks angka
text_as_int = [char_to_idx[c] for c in raw_text]

def create_training_batches(data, seq_length=32, batch_size=16):
    """
    Membagi deretan token angka menjadi batch input (X) dan target (y).
    Target (y) adalah pergeseran 1 karakter ke depan dari input (X).
    """
    inputs, targets = [], []
    for i in range(0, len(data) - seq_length):
        inputs.append(data[i : i + seq_length])
        targets.append(data[i + 1 : i + seq_length + 1])
    
    # Acak data agar pembelajaran tidak bias
    combined = list(zip(inputs, targets))
    random.seed(42)
    random.shuffle(combined)
    inputs, targets = zip(*combined)
    
    # Batasi ke kelipatan batch_size
    n_batches = len(inputs) // batch_size
    inputs = inputs[: n_batches * batch_size]
    targets = targets[: n_batches * batch_size]
    
    X = torch.tensor(inputs, dtype=torch.long)
    y = torch.tensor(targets, dtype=torch.long)
    
    batches = []
    for i in range(0, len(X), batch_size):
        batches.append((X[i : i + batch_size], y[i : i + batch_size]))
    return batches

# ==========================================
# 2. ARSITEKTUR MODEL JARINGAN SARAF (LSTM)
# ==========================================

class CharLanguageModel(nn.Module):
    def __init__(self, vocab_size, embedding_dim=64, hidden_dim=128, num_layers=2, dropout=0.2):
        super(CharLanguageModel, self).__init__()
        self.vocab_size = vocab_size
        self.hidden_dim = hidden_dim
        self.num_layers = num_layers
        
        # 1. Lapisan Embedding: Mengubah integer token menjadi representasi vektor kontinu
        self.embedding = nn.Embedding(vocab_size, embedding_dim)
        
        # 2. Lapisan Hidden (LSTM): Mengingat urutan dan relasi antar karakter
        self.lstm = nn.LSTM(
            embedding_dim,
            hidden_dim,
            num_layers=num_layers,
            dropout=dropout if num_layers > 1 else 0.0,
            batch_first=True
        )
        
        # 3. Lapisan Dropout untuk regularisasi
        self.dropout = nn.Dropout(dropout)
        
        # 4. Lapisan Linear Output: Memetakan hidden state kembali ke ukuran kosakata (vocab_size)
        self.fc = nn.Linear(hidden_dim, vocab_size)

    def forward(self, x, hidden=None):
        embeds = self.embedding(x)
        lstm_out, hidden = self.lstm(embeds, hidden)
        lstm_out = self.dropout(lstm_out)
        logits = self.fc(lstm_out)
        return logits, hidden

    def init_hidden(self, batch_size, device):
        weight = next(self.parameters()).data
        hidden = (
            weight.new(self.num_layers, batch_size, self.hidden_dim).zero_().to(device),
            weight.new(self.num_layers, batch_size, self.hidden_dim).zero_().to(device)
        )
        return hidden

# ==========================================
# 3. PROSEDUR PELATIHAN (TRAINING LOOP)
# ==========================================

def train_model(model, batches, epochs=120, lr=0.005, device='cpu'):
    model.to(device)
    optimizer = optim.Adam(model.parameters(), lr=lr)
    criterion = nn.CrossEntropyLoss()
    
    print("\n" + "="*50)
    print("MEMULAI PROSES PELATIHAN MODEL AI...")
    print("="*50)
    
    start_time = time.time()
    for epoch in range(1, epochs + 1):
        model.train()
        total_loss = 0.0
        
        for X_batch, y_batch in batches:
            X_batch, y_batch = X_batch.to(device), y_batch.to(device)
            
            optimizer.zero_grad()
            logits, _ = model(X_batch)
            
            # Bentuk ulang dimensi untuk kalkulasi loss
            # logits: [batch_size * seq_length, vocab_size]
            # y_batch: [batch_size * seq_length]
            loss = criterion(logits.view(-1, model.vocab_size), y_batch.view(-1))
            loss.backward()
            
            # Gradient clipping untuk mencegah ledakan gradien
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
            optimizer.step()
            
            total_loss += loss.item()
            
        avg_loss = total_loss / len(batches)
        if epoch % 20 == 0 or epoch == 1:
            elapsed = time.time() - start_time
            print(f"Epoch [{epoch:03d}/{epochs:03d}] | Loss: {avg_loss:.4f} | Waktu: {elapsed:.2f}s")
            
    print("="*50)
    print("PELATIHAN SELESAI!")
    print("="*50 + "\n")

# ==========================================
# 4. PEMBANGKITAN TEKS (INFERENCE / SAMPLING)
# ==========================================

def generate_text(model, start_text="Kecerdasan", length=200, temperature=0.7, device='cpu'):
    """
    Menghasilkan teks baru berdasarkan prompt awal menggunakan sampling temperatur.
    Temperatur rendah -> lebih percaya diri dan patuh pada pola dominan.
    Temperatur tinggi -> lebih kreatif / variatif tapi rentan salah ketik.
    """
    model.eval()
    model.to(device)
    
    # Validasi karakter awal
    input_indices = [char_to_idx[c] for c in start_text if c in char_to_idx]
    if not input_indices:
        input_indices = [random.randint(0, model.vocab_size - 1)]
        
    input_tensor = torch.tensor([input_indices], dtype=torch.long).to(device)
    hidden = None
    
    generated_text = start_text
    
    with torch.no_grad():
        # Masukkan prompt awal ke model untuk menghangatkan hidden state
        for i in range(len(input_indices) - 1):
            _, hidden = model(input_tensor[:, i:i+1], hidden)
            
        last_input = input_tensor[:, -1:]
        
        # Mulai loop prediksi karakter berikutnya satu per satu
        for _ in range(length):
            logits, hidden = model(last_input, hidden)
            
            # Terapkan temperature scaling pada distribusi probabilitas
            logits = logits.squeeze().div(temperature)
            probabilities = torch.softmax(logits, dim=-1)
            
            # Sampling karakter berikutnya berdasarkan distribusi probabilitas
            next_idx = torch.multinomial(probabilities, num_samples=1).item()
            
            next_char = idx_to_char[next_idx]
            generated_text += next_char
            
            # Karakter yang baru ditebak dijadikan input untuk langkah berikutnya
            last_input = torch.tensor([[next_idx]], dtype=torch.long).to(device)
            
    return generated_text

# ==========================================
# 5. EKSEKUSI UTAMA (MAIN RUNNER)
# ==========================================

if __name__ == "__main__":
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Perangkat komputasi: {device}")
    
    # 1. Siapkan data batch
    SEQ_LENGTH = 24
    BATCH_SIZE = 8
    batches = create_training_batches(text_as_int, seq_length=SEQ_LENGTH, batch_size=BATCH_SIZE)
    
    # 2. Inisialisasi model
    ai_model = CharLanguageModel(
        vocab_size=vocab_size,
        embedding_dim=64,
        hidden_dim=128,
        num_layers=2,
        dropout=0.15
    )
    
    # 3. Latih model
    train_model(ai_model, batches, epochs=140, lr=0.008, device=device)
    
    # 4. Uji coba pembuatan teks baru (Inferensi)
    print("HASIL GENERASI TEKS MODEL:")
    prompt = "Kecerdasan"
    hasil = generate_text(ai_model, start_text=prompt, length=250, temperature=0.6, device=device)
    print(f"Prompt Awal: '{prompt}'")
    print("-" * 40)
    print(hasil)
    print("-" * 40)
